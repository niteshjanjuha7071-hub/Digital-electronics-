module alu16(
2 input wire [15:0] a,
3 input wire [15:0] b,
4 input wire [2:0] op ,
5 output reg [15:0] y
6 );
7 always @(*) begin
8 case(op)
9 3'b000: y = a + b;
10 3'b001: y = a - b;
11 3'b010: y = a & b;
12 3'b011: y = a | b;
13 3'b100: y = a ^ b;
14 default: y = 16'b0;
15 endcase
16 end
17 endmodule
